# ---------------------------------------------------------------------------
# VoiceKernel - environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Public URL of this API. Used to build the serverUrl we register with the voice provider so
# that every provider event routes back through VoiceKernel.
PUBLIC_BASE_URL=http://localhost:8080

# Postgres connection string.
DATABASE_URL=postgres://voicekernel:voicekernel@localhost:55432/voicekernel

# Signs dashboard session JWTs. 32+ bytes of randomness.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# AES-256-GCM key protecting tenant secrets at rest (BYO the voice provider keys, webhook
# secrets). MUST be exactly 32 bytes, base64 encoded. Rotating this key without
# re-encrypting will make every stored secret unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Platform-wide provider key. Used for tenants running in "platform" mode, where
# VoiceKernel owns the provider account and enforces tenant isolation itself.
# Tenants in "byo" mode supply their own key instead.
PROVIDER_API_KEY=

# Browser test calls ("Talk" in the console) are created against an endpoint
# that authenticates with the provider's PUBLIC key, not the private one above.
# Sending the private key there returns 401 telling you to swap them. Leave
# blank to disable in-browser calls; everything else works without it.
PROVIDER_PUBLIC_KEY=

PROVIDER_BASE_URL=https://api.vapi.ai

# Shared secret the voice provider signs its inbound webhooks with (set the same value in the
# the voice provider dashboard). Leave blank to disable verification in local development.
PROVIDER_WEBHOOK_SECRET=

# CORS allowlist for the dashboard / customer browser apps. Comma separated.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Rate limiting (per API key, sliding window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# Outbound webhook delivery worker.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_WORKER_INTERVAL_MS=2000
WEBHOOK_TIMEOUT_MS=10000

# Set to "true" to allow public self-serve signup. When false, only invites.
ALLOW_SIGNUP=true
