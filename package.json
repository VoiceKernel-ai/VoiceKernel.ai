{
  "name": "voicekernel",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source, enterprise-ready agentic conversational voice layer.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build:web": "tsx scripts/build-web.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "test:sdk": "cd packages/sdk-typescript && npx tsx --test test/sdk.test.ts",
    "gen:favicons": "tsx scripts/gen-favicons.ts",
    "gen:docs": "tsx scripts/gen-docs.ts",
    "gen:provider": "tsx scripts/gen-provider-operations.ts && tsx scripts/gen-provider-catalog.ts",
    "gen:marketing": "tsx scripts/gen-marketing.ts",
    "build:site": "npm run gen:docs && npm run gen:marketing && npm run build:web"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.91.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoiceKernel-ai/VoiceKernel.ai.git"
  },
  "homepage": "https://github.com/VoiceKernel-ai/VoiceKernel.ai#readme",
  "bugs": {
    "url": "https://github.com/VoiceKernel-ai/VoiceKernel.ai/issues"
  },
  "keywords": [
    "voice-ai",
    "voice-agents",
    "conversational-ai",
    "agentic",
    "realtime",
    "multi-tenant",
    "control-plane",
    "enterprise",
    "open-source",
    "webrtc"
  ]
}
