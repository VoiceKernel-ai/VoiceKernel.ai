    "/v1/calls/{id}/artifacts/{artifact}": {
      "get": {
        "tags": [
          "Calls"
        ],
        "summary": "Presigned URL for a recording, pcap or call log",
        "responses": {
          "200": {
            "description": "{ url, expiresIn, artifact }"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "artifact",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "recording",
              "mono-recording",
              "stereo-recording",
              "video-recording",
              "customer-recording",
              "assistant-recording",
              "pcap",
              "logs"
            ]
          }
        }
      ]
    },
